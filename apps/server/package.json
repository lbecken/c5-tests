{
  "name": "@gitscope/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts"
  },
  "bin": {
    "gitscope-server": "./dist/gitscope-server.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -b",
    "dev": "node build.mjs && node dist/gitscope-server.mjs",
    "start": "node dist/gitscope-server.mjs"
  },
  "dependencies": {
    "@gitscope/core": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2"
  }
}

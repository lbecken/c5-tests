# reader-tts configuration.
#
# Every value below is a default. Copy this file to .env for your own reference,
# or export the variables directly: the application reads the environment and
# does not require dotenv at runtime.
#
# Configuration is validated at startup; an invalid value fails immediately with
# a message naming the field.

# --- Directories --------------------------------------------------------------
# Pinned data that ships with the repository (the pronunciation dictionary).
READER_TTS_DATA_DIR=./data

# Everything the application writes: database, cached audio, exports, temporary
# files. Deleting this directory resets the application; nothing in it is
# irreplaceable.
READER_TTS_RUNTIME_DIR=./runtime

# Defaults to <runtime dir>/reader_tts.sqlite3 when unset.
# READER_TTS_DATABASE_PATH=./runtime/reader_tts.sqlite3

# Where scripts/download_model.py placed the model and voices.
READER_TTS_MODEL_DIR=./models/kokoro

# --- Engine ---------------------------------------------------------------------
# 'kokoro' is the real neural engine. 'fake' is a deterministic engine that needs
# no model, used by the tests and useful for developing the interface offline.
READER_TTS_ENGINE=kokoro

# Recorded in cache keys and reported by the health route.
READER_TTS_MODEL_ID=kokoro-82m

READER_TTS_DEFAULT_VOICE=af_heart

# Must fall within 0.75 to 1.25.
READER_TTS_DEFAULT_SPEED=1.0

# 'auto' uses CUDA when it is available and stable, otherwise CPU.
READER_TTS_DEVICE=auto

# Units synthesized at once. Raise only after profiling model stability and
# memory use; correctness and predictable resource use matter more than
# throughput.
READER_TTS_MAX_CONCURRENCY=1

# --- Pauses, in milliseconds -------------------------------------------------------
# Inserted between technical chunks of one long sentence.
READER_TTS_CHUNK_PAUSE_MS=80

# Inserted between sentences.
READER_TTS_SENTENCE_PAUSE_MS=220

# Inserted at paragraph boundaries; must exceed the sentence pause to be
# perceptible as a larger break.
READER_TTS_PARAGRAPH_PAUSE_MS=550

# --- Sentence chunking ----------------------------------------------------------------
# Sentences longer than this are split at the safest available boundary.
READER_TTS_PREFERRED_MAX_CHARS=350

# No chunk sent to the engine exceeds this.
READER_TTS_HARD_MAX_CHARS=600

# --- Limits ---------------------------------------------------------------------------
READER_TTS_MAX_DOCUMENT_CHARACTERS=2000000
READER_TTS_MAX_REQUEST_BYTES=8388608

# --- Server -----------------------------------------------------------------------------
# Binding anywhere other than the loopback interface exposes an application with
# no authentication. The application logs a warning if you do.
READER_TTS_HOST=127.0.0.1
READER_TTS_PORT=8765

# DEBUG may log truncated document text; INFO and above never do.
READER_TTS_LOG_LEVEL=INFO
